# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres. App: transaction pooler (port 6543). Migrations: direct connection.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

APP_URL=http://localhost:3000
# Random strings, at least 16 chars. NIK_HASH_SECRET must never change once set.
CRON_SECRET=
NIK_HASH_SECRET=

# mock | xendit
PAYMENT_PROVIDER=mock
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Business rules (basis points: 100 = 1%). Defaults shown.
POSTING_FEE_BPS=500
WITHDRAWAL_FEE_BPS=250
CANCEL_FEE_BPS=2000
MIN_REWARD=50000
MIN_WITHDRAWAL=50000
POST_DURATION_DAYS=60
CLAIM_REVIEW_DAYS=3
DISPUTE_WINDOW_DAYS=3
